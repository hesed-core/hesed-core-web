---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  variant: string;
  accent?: 'aqua' | 'coral' | 'violet';
}
const { eyebrow, title, description, variant, accent = 'aqua' } = Astro.props;
---
<section class={`internal-hero internal-hero-${variant} internal-accent-${accent}`}>
  <div class="container internal-hero-grid">
    <div class="internal-hero-copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="hero-lead">{description}</p>
    </div>
    <div class="internal-hero-visual"><slot /></div>
  </div>
</section>
