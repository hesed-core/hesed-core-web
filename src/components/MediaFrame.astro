---
interface Props {
  variant?: 'product' | 'architecture' | 'editorial' | 'brand' | 'interface';
  accent?: 'aqua' | 'coral' | 'violet';
  label?: string;
  caption?: string;
}
const { variant = 'editorial', accent = 'aqua', label, caption } = Astro.props;
---
<figure class={`media-frame media-frame-${variant} media-accent-${accent}`}>
  <div class="media-frame-glow" aria-hidden="true"></div>
  <div class="media-frame-content"><slot /></div>
  {label && <span class="media-frame-label">{label}</span>}
  {caption && <figcaption>{caption}</figcaption>}
</figure>
