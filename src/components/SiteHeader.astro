---
const groups = [
  {
    label: 'Plataforma',
    links: [
      { href: '/plataforma', title: 'Ver toda la plataforma', description: 'Ecosistema Hesed Core y capacidades compartidas.' },
      { href: '/plataforma', title: 'Ecosistema Hesed Core', description: 'El núcleo y sus capacidades compartidas.' },
      { href: '/plataforma#capacidades', title: 'Capacidades compartidas', description: 'Identidad, seguridad, datos y almacenamiento.' }
    ]
  },
  {
    label: 'Productos',
    links: [
      { href: '/productos', title: 'Ver todos los productos', description: 'TrimmOS y la visión de producto.' },
      { href: '/productos', title: 'TrimmOS', description: 'Operación para barberías y negocios de belleza.' },
      { href: '/productos#vision', title: 'Visión de producto', description: 'Iniciativas futuras, claramente diferenciadas.' }
    ]
  },
  {
    label: 'Ingeniería',
    links: [
      { href: '/ingenieria', title: 'Conocer nuestra ingeniería', description: 'La forma en que construimos.' },
      { href: '/ingenieria', title: 'Nuestra forma de construir', description: 'Decisiones, arquitectura y evolución.' },
      { href: '/ingenieria#tecnologia', title: 'Arquitectura y tecnología', description: 'Tecnologías elegidas con propósito.' }
    ]
  },
  {
    label: 'Empresa',
    links: [
      { href: '/empresa', title: 'Conocer Hesed Core', description: 'Propósito, cultura y responsabilidad.' },
      { href: '/empresa', title: 'Propósito y cultura', description: 'La forma en que entendemos nuestro trabajo.' },
      { href: '/contacto', title: 'Contacto', description: 'Conversemos sobre lo que necesitas construir.' }
    ]
  }
];
---
<header class="site-header" id="site-header">
  <div class="nav-shell">
    <a class="brand" href="/" aria-label="Hesed Core, inicio">
      <img src="/brand/hesed-core-isotipo.png" alt="" width="36" height="36" class="brand-mark" />
      <span class="brand-wordmark"><strong>HESED</strong><span>CORE</span></span>
    </a>
    <nav class="desktop-nav" aria-label="Navegación principal">
      {groups.map((group) => (
        <div class="nav-group">
          <button class="nav-trigger" type="button" aria-expanded="false" aria-haspopup="true" aria-controls={`menu-${group.label.toLowerCase()}`}>
            {group.label}<span aria-hidden="true">+</span>
          </button>
          <div class="mega-menu" id={`menu-${group.label.toLowerCase()}`} aria-hidden="true">
            {group.links.map((link) => <a href={link.href}><strong>{link.title}</strong><small>{link.description}</small></a>)}
          </div>
        </div>
      ))}
      <a class="nav-direct" href="/seguridad">Seguridad</a>
    </nav>
    <a class="header-cta" href="/contacto">Hablar con Hesed Core</a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Abrir menú">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="mobile-menu" id="mobile-menu" hidden>
    <div class="mobile-menu-brand"><img src="/brand/hesed-core-isotipo.png" alt="" width="32" height="32" class="brand-mark" /><span class="brand-wordmark"><strong>HESED</strong><span>CORE</span></span></div>
    {groups.map((group) => (
      <details><summary>{group.label}</summary><div class="mobile-subnav">{group.links.map((link) => <a href={link.href}><strong>{link.title}</strong><small>{link.description}</small></a>)}</div></details>
    ))}
    <a class="mobile-direct" href="/seguridad">Seguridad</a>
    <a class="header-cta" href="/contacto">Hablar con Hesed Core</a>
  </div>
</header>
<script>
  const header = document.querySelector<HTMLElement>('#site-header');
  const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const mobileMenu = document.querySelector<HTMLElement>('#mobile-menu');
  const triggers = [...document.querySelectorAll<HTMLButtonElement>('.nav-trigger')];
  let openTrigger: HTMLButtonElement | null = null;
  let openTimer = 0;
  let closeTimer = 0;
  const getMenu = (trigger: HTMLButtonElement) => document.getElementById(trigger.getAttribute('aria-controls') ?? '');
  const setMenuState = (trigger: HTMLButtonElement, open: boolean) => {
    const menu = getMenu(trigger);
    trigger.setAttribute('aria-expanded', String(open));
    menu?.classList.toggle('is-open', open);
    menu?.setAttribute('aria-hidden', String(!open));
  };
  const closeMenus = () => {
    window.clearTimeout(openTimer);
    window.clearTimeout(closeTimer);
    triggers.forEach((trigger) => setMenuState(trigger, false));
    openTrigger = null;
  };
  const openMenu = (trigger: HTMLButtonElement, focusFirst = false) => {
    window.clearTimeout(openTimer);
    window.clearTimeout(closeTimer);
    triggers.forEach((item) => { if (item !== trigger) setMenuState(item, false); });
    setMenuState(trigger, true);
    openTrigger = trigger;
    if (focusFirst) getMenu(trigger)?.querySelector<HTMLElement>('a')?.focus();
  };
  const scheduleOpen = (trigger: HTMLButtonElement) => { window.clearTimeout(closeTimer); window.clearTimeout(openTimer); openTimer = window.setTimeout(() => openMenu(trigger), 140); };
  const scheduleClose = () => { window.clearTimeout(openTimer); window.clearTimeout(closeTimer); closeTimer = window.setTimeout(closeMenus, 300); };

  triggers.forEach((trigger) => {
    const group = trigger.closest('.nav-group');
    const menu = getMenu(trigger);
    trigger.addEventListener('click', () => {
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';
      if (isOpen) closeMenus(); else openMenu(trigger);
    });
    trigger.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') { event.preventDefault(); openMenu(trigger, true); }
    });
    group?.addEventListener('pointerenter', () => {
      if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) scheduleOpen(trigger);
    });
    group?.addEventListener('pointerleave', scheduleClose);
    menu?.addEventListener('pointerenter', () => window.clearTimeout(closeTimer));
    menu?.addEventListener('pointerleave', scheduleClose);
  });
  document.addEventListener('click', (event) => { if (header && !header.contains(event.target as Node)) closeMenus(); });
  document.addEventListener('focusin', (event) => { if (header && !header.contains(event.target as Node)) closeMenus(); });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      const focusTarget = openTrigger;
      closeMenus();
      if (mobileMenu && menuToggle) { mobileMenu.hidden = true; menuToggle.setAttribute('aria-expanded', 'false'); document.body.classList.remove('menu-open'); }
      focusTarget?.focus();
    }
  });
  document.querySelectorAll<HTMLAnchorElement>('.mega-menu a').forEach((link) => link.addEventListener('click', closeMenus));
  menuToggle?.addEventListener('click', () => { if (!mobileMenu || !menuToggle) return; const open = !mobileMenu.hidden; mobileMenu.hidden = open; menuToggle.setAttribute('aria-expanded', String(!open)); document.body.classList.toggle('menu-open', !open); });
  mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => { closeMenus(); if (mobileMenu && menuToggle) { mobileMenu.hidden = true; menuToggle.setAttribute('aria-expanded', 'false'); document.body.classList.remove('menu-open'); } }));
  const updateHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  updateHeader(); window.addEventListener('scroll', updateHeader, { passive: true });
</script>
