---
import CorporateHomeLayoutV2 from '../layouts/CorporateHomeLayoutV2.astro';
import CorporateHeaderV2 from '../components/v2/CorporateHeaderV2.astro';
import EditorialHeroV2 from '../components/v2/EditorialHeroV2.astro';
import PurposeStatementV2 from '../components/v2/PurposeStatementV2.astro';
import EcosystemEditorialV2 from '../components/v2/EcosystemEditorialV2.astro';
import MethodEditorialV2 from '../components/v2/MethodEditorialV2.astro';
import SecurityCultureV2 from '../components/v2/SecurityCultureV2.astro';
import CorporateCtaV2 from '../components/v2/CorporateCtaV2.astro';
import CorporateFooterV2 from '../components/v2/CorporateFooterV2.astro';
---

<CorporateHomeLayoutV2
  title="Hesed Core | Ingeniería de Software con Propósito"
  description="Diseñamos plataformas y productos digitales con arquitectura consciente, seguridad desde el origen y visión de largo plazo."
>
  <CorporateHeaderV2 />
  <main id="main-content" tabindex="-1">
    <EditorialHeroV2 />
    <PurposeStatementV2 />
    <EcosystemEditorialV2 />
    <MethodEditorialV2 />
    <SecurityCultureV2 />
    <CorporateCtaV2 />
  </main>
  <CorporateFooterV2 />
</CorporateHomeLayoutV2>
