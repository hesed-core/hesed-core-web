---
import BaseLayout from '../components/BaseLayout.astro';
---
<BaseLayout title="Hesed Core | Ingeniería de Software con Propósito" description="Hesed Core diseña plataformas y productos digitales con arquitectura escalable, identidades separadas y seguridad integrada desde el origen.">
  <section class="home-hero">
    <div class="container hero-grid">
      <div class="hero-copy reveal">
        <p class="eyebrow">Ingeniería de software con propósito</p>
        <h1>Ingeniería de software diseñada para evolucionar con seguridad.</h1>
        <p class="hero-lead">Diseñamos plataformas y productos digitales con arquitectura escalable, identidades separadas y seguridad integrada desde el origen.</p>
        <div class="actions"><a class="button button-primary" href="/plataforma">Conocer el ecosistema</a><a class="button button-quiet" href="/contacto">Hablar con Hesed Core</a></div>
        <p class="hero-note">Security by Culture <span>·</span> García, Nuevo León, México</p>
      </div>
      <div class="hero-visual reveal reveal-delay" aria-label="Relación conceptual del ecosistema Hesed Core">
        <div class="core-orb" data-core-orb>
          <div class="orb-aura" aria-hidden="true"></div>
          <svg class="orb-orbits" viewBox="0 0 620 480" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
            <ellipse class="orb-orbit orb-orbit-wide" cx="310" cy="240" rx="258" ry="148" />
            <ellipse class="orb-orbit orb-orbit-tight" cx="310" cy="240" rx="190" ry="108" />
            <circle class="orb-marker marker-left" cx="63" cy="240" r="3" />
            <circle class="orb-marker marker-right" cx="557" cy="240" r="3" />
          </svg>
          <button class="orb-product orb-product-left" type="button" data-orb-target="business">
            <small>Producto</small>
            <strong>Business / TrimmOS</strong>
          </button>
          <button class="orb-product orb-product-right" type="button" data-orb-target="customer">
            <small>Producto</small>
            <strong>Hesed Customer Platform</strong>
          </button>
          <div class="orb-core" data-orb-target="core">
            <img src="/brand/hesed-core-isotipo.png" alt="" width="72" height="72" />
            <strong>Hesed Core Platform</strong>
            <small>Núcleo del ecosistema</small>
          </div>
          <span class="orb-data-dot orb-data-dot-one" aria-hidden="true"></span>
          <span class="orb-data-dot orb-data-dot-two" aria-hidden="true"></span>
        </div>
      </div>
    </div>
  </section>

  <section class="home-section principles-section" data-reveal-section>
    <div class="container narrow-intro"><p class="eyebrow">Nuestra forma de construir</p><h2>Arquitectura, seguridad y evolución desde el origen.</h2><p>No construimos funciones aisladas. Diseñamos bases tecnológicas capaces de crecer, separar responsabilidades y sostener nuevos productos.</p></div>
    <div class="container principle-list">
      <article><span>01</span><div><h3>Arquitectura preparada para evolucionar</h3><p>Separamos dominios, identidades y responsabilidades para que cada producto pueda crecer con claridad.</p></div></article>
      <article><span>02</span><div><h3>Security by Culture</h3><p>La seguridad forma parte de cada decisión, desde la identidad hasta los datos y la operación.</p></div></article>
      <article><span>03</span><div><h3>Productos conectados</h3><p>Un núcleo de capacidades compartidas permite construir experiencias independientes sin duplicar fundamentos.</p></div></article>
    </div>
  </section>

  <section class="home-section ecosystem-section" data-reveal-section>
    <div class="container split-heading"><div><p class="eyebrow">Ecosistema Hesed Core</p><h2>Un núcleo compartido. Productos con identidad propia.</h2></div><div><p>Hesed Core Platform concentra capacidades fundamentales mientras cada producto conserva su propósito, experiencia e identidad.</p><a class="text-link" href="/plataforma">Explorar la plataforma <span>↗</span></a></div></div>
    <div class="container ecosystem-summary"><div class="summary-core"><img src="/brand/hesed-core-isotipo.png" alt="" width="52" height="52" /><strong>Hesed Core Platform</strong><small>Núcleo del ecosistema</small></div><div class="summary-product"><small>Producto</small><strong>Business / TrimmOS</strong><span>Operación de negocios</span></div><div class="summary-product"><small>Producto</small><strong>Hesed Customer Platform</strong><span>Experiencia del cliente</span></div><div class="summary-capabilities"><small>Capacidades compartidas</small><span>Identidad</span><span>Seguridad</span><span>Datos</span><span>Almacenamiento</span></div></div>
  </section>

  <section class="home-section product-feature" data-reveal-section><div class="container product-feature-grid"><div><p class="eyebrow">Producto destacado</p><h2>TrimmOS</h2><p>Una plataforma operativa para barberías y negocios de belleza que integra agenda, clientes, servicios, personal y administración en una experiencia conectada.</p><a class="button button-primary" href="https://trimmos.com" target="_blank" rel="noopener noreferrer">Conocer TrimmOS</a><a class="text-link" href="/productos">Ver productos <span>↗</span></a></div><div class="product-art"><div class="product-art-glow" aria-hidden="true"></div><img src="/logo.png" alt="Logo de TrimmOS" width="180" height="180" /><span>Próximo lanzamiento</span></div></div></section>

  <section class="home-section security-feature" data-reveal-section><div class="container security-feature-grid"><div><p class="eyebrow">Security by Culture</p><h2>La seguridad no es una etapa. Es parte de nuestra cultura.</h2><p>Integramos identidad, control de acceso, protección de datos y trazabilidad desde las primeras decisiones de arquitectura.</p><a class="button button-dark" href="/seguridad">Conocer nuestra visión de seguridad</a></div><div class="statement-list"><span>Identidad y acceso</span><span>Protección de información</span><span>Responsabilidad operativa</span></div></div></section>

  <section class="home-section contact-feature"><div class="container contact-feature-inner"><p class="eyebrow">Hablemos</p><h2>Conversemos sobre lo que necesitas construir.</h2><p>Cuéntanos el reto. Nosotros ayudamos a convertirlo en una solución clara, mantenible y preparada para evolucionar.</p><a class="button button-primary" href="/contacto">Hablar con Hesed Core</a></div></section>

  <script>
    document.documentElement.classList.add('js-ready');
    const revealSections = [...document.querySelectorAll<HTMLElement>('[data-reveal-section]')];
    const revealAll = () => revealSections.forEach((section) => section.classList.add('is-visible'));
    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.16 });
    revealSections.forEach((section) => revealObserver.observe(section));
    window.setTimeout(revealAll, 1200);

    const coreOrb = document.querySelector<HTMLElement>('[data-core-orb]');
    const orbTargets = [...document.querySelectorAll<HTMLElement>('[data-orb-target]')];
    const canParallax = window.matchMedia('(hover: hover) and (pointer: fine)').matches && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const resetOrb = () => {
      if (coreOrb) {
        coreOrb.style.setProperty('--orb-x', '0px');
        coreOrb.style.setProperty('--orb-y', '0px');
      }
    };

    if (coreOrb && canParallax) {
      coreOrb.addEventListener('pointermove', (event) => {
        const bounds = coreOrb.getBoundingClientRect();
        const x = ((event.clientX - bounds.left) / bounds.width - 0.5) * 10;
        const y = ((event.clientY - bounds.top) / bounds.height - 0.5) * 10;
        coreOrb.style.setProperty('--orb-x', `${x.toFixed(2)}px`);
        coreOrb.style.setProperty('--orb-y', `${y.toFixed(2)}px`);
      });
      coreOrb.addEventListener('pointerleave', resetOrb);
    }

    orbTargets.forEach((target) => {
      const targetName = target.dataset.orbTarget;
      if (!targetName || targetName === 'core') return;
      const related = orbTargets.filter((item) => item.dataset.orbTarget === targetName || item.dataset.orbTarget === 'core');
      const activate = () => {
        orbTargets.forEach((item) => item.classList.toggle('is-dimmed', !related.includes(item)));
        related.forEach((item) => item.classList.add('is-active'));
      };
      const clear = () => orbTargets.forEach((item) => item.classList.remove('is-dimmed', 'is-active'));
      target.addEventListener('pointerenter', activate);
      target.addEventListener('focus', activate);
      target.addEventListener('pointerleave', clear);
      target.addEventListener('blur', clear);
    });
  </script>
</BaseLayout>
