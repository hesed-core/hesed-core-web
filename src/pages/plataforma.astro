---
import CorporateInternalLayoutV2 from '../layouts/CorporateInternalLayoutV2.astro';
import InternalHeroV2 from '../components/v2/InternalHeroV2.astro';
import EditorialCtaV2 from '../components/v2/EditorialCtaV2.astro';

const capabilities = [
  {
    number: '01',
    title: 'Identidad',
    description: 'Identidad y autenticación como fundamentos para organizar el acceso a productos y servicios.'
  },
  {
    number: '02',
    title: 'Seguridad',
    description: 'Principios de seguridad y controles integrados desde las decisiones de diseño.'
  },
  {
    number: '03',
    title: 'Datos',
    description: 'Estructuras que consideran integridad, escalabilidad y políticas de acceso.'
  },
  {
    number: '04',
    title: 'Almacenamiento',
    description: 'Capacidades para conservar y operar información de forma mantenible.'
  }
];
---

<CorporateInternalLayoutV2
  title="Plataforma | Hesed Core"
  description="El núcleo tecnológico del ecosistema Hesed Core y sus capacidades compartidas."
  path="/plataforma"
>
  <InternalHeroV2
    page="platform"
    eyebrow="Hesed Core Platform"
    title="El núcleo tecnológico del ecosistema Hesed Core."
    description="Hesed Core Platform concentra capacidades compartidas para que cada producto pueda evolucionar con identidad, seguridad y responsabilidades claramente separadas."
    imageSrc="/hesed-core-isotipo-transparente.png"
    imageAlt=""
  />

  <section class="v2-platform-statement">
    <div class="v2-wrap v2-platform-statement__inner">
      <p class="v2-section-index">01 / Fundamentos</p>
      <h2>Capacidades compartidas.<br />Responsabilidades claramente separadas.</h2>
    </div>
  </section>

  <section class="v2-platform-capabilities" id="capacidades" aria-labelledby="v2-platform-capabilities-title">
    <div class="v2-wrap">
      <div class="v2-editorial-heading">
        <p class="v2-eyebrow">02 / Capacidades compartidas</p>
        <h2 id="v2-platform-capabilities-title">Fundamentos para construir con claridad.</h2>
      </div>
      <ol class="v2-capability-list">
        {capabilities.map((capability) => (
          <li>
            <span>{capability.number}</span>
            <h3>{capability.title}</h3>
            <p>{capability.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="v2-platform-role">
    <div class="v2-wrap v2-platform-role__inner">
      <p class="v2-eyebrow v2-eyebrow--light">03 / Ecosistema</p>
      <h2>Una base común. Productos con propósito e identidad propia.</h2>
      <p>
        El crecimiento de un producto permite reconocer qué responsabilidades conviene separar
        y qué capacidades pueden compartirse. La plataforma sostiene esa evolución sin borrar
        la identidad de cada experiencia.
      </p>
    </div>
  </section>

  <section class="v2-platform-evolution">
    <div class="v2-wrap v2-platform-evolution__inner">
      <p class="v2-section-index">04 / Evolución arquitectónica</p>
      <div>
        <h2>Crecer con límites claros y fundamentos mantenibles.</h2>
        <p>
          Business / TrimmOS y Hesed Customer Platform conservan su propósito, experiencia e
          identidad mientras evolucionan sobre capacidades compartidas.
        </p>
      </div>
    </div>
  </section>

  <EditorialCtaV2
    eyebrow="05 / Hablemos"
    title="¿Estás pensando en construir un producto que pueda evolucionar?"
    description="Conversemos sobre el reto, el contexto y los fundamentos que necesita."
  />
</CorporateInternalLayoutV2>
